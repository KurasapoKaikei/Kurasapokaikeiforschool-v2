# ============================================================
# クラサポ会計 — 環境変数のひな形
#
#   cp .env.example .env
#
# 本番・ステージングではこのファイルは使わない。
# 値は AWS SSM Parameter Store（SecureString）に置き、
# ECS タスク定義の secrets で注入する（インフラ設計書 §3.8）。
# .env は .gitignore 済み。絶対にコミットしないこと。
# ============================================================

# --- データベース ---------------------------------------------
# docker compose up -d db で起動する PostgreSQL に接続する既定値
DATABASE_URL="postgresql://kurasapo:kurasapo@localhost:5432/kurasapo_dev?schema=public"

# --- 認証（Auth.js / P1 で使用）--------------------------------
# 本番用は `openssl rand -base64 32` で生成すること
AUTH_SECRET="local-development-secret-do-not-use-in-production"

# --- 証憑 OCR --------------------------------------------------
# 現状は Google Generative AI（Gemini）。
# インフラ設計書 D-1 のとおり、Vertex AI 東京リージョンへの移行を推奨。
GOOGLE_GEMINI_API_KEY=""

# --- 実行時メタ情報（任意）-------------------------------------
# ECS では deploy.sh がイメージタグを埋め込む。/api/health で返る
APP_REVISION="local"
