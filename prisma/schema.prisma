// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ユーザー・認証・組織管理
// ============================================

enum UserRole {
  UniversityAdmin  // 大学管理者（for School版）
  FacultyAuditor   // 顧問（監査者）
  ClubStudent      // クラブ学生
  ClubAdmin        // クラブ管理者（単体版）
}

enum OrganizationType {
  UNIVERSITY       // 大学（for School版）
  CLUB             // クラブ（単体版）
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String
  role          UserRole
  organizationId String?
  organization  Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // リレーション
  transactions       Transaction[]
  approvals          Approval[]
  createdFiscalYears FiscalYear[]  @relation("FiscalYearCreator")
  alerts             Alert[]       @relation("AlertResolvedBy")

  @@index([organizationId])
  @@index([email])
}

model Organization {
  id                  String           @id @default(cuid())
  name                String
  type                OrganizationType @default(CLUB)
  allowCustomCategory Boolean          @default(true)  // クラブ固有のカテゴリー/科目を許可するか
  isForSchool         Boolean          @default(false) // for School版かどうか
  parentId            String?          // for School版の場合、親組織（大学）のID
  parent              Organization?    @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children            Organization[]   @relation("OrganizationHierarchy")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // リレーション
  users           User[]
  fiscalYears     FiscalYear[]
  categories      Category[]
  accountTitles   AccountTitle[]
  transactions    Transaction[]
  members         Member[]
  parents         Parent[]
  collectionItems CollectionItem[]
  alerts          Alert[]
  budgets         Budget[]
  /// クラブ単位の拡張情報（担当者名簿など）。Organization と 1:1
  club            Club?

  @@index([parentId])
  @@index([type])
}

/// クラブ（団体）プロファイル。DB上の「クラブ」エンティティは Organization に対応し、本モデルは 1:1 で紐づく
model Club {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// 担当者氏名（最大5名を想定。空要素は保存しない）
  staffNames     String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

// ============================================
// 会計年度管理
// ============================================

/// 会計年度の業務ステータス（三者間連携・ロック判定に使用）
/// 旧: OPEN/PENDING/PENDING_CLOSE/CLOSED は段階移行で DRAFT/SUBMITTED/APPROVED へ寄せる
enum FiscalYearStatus {
  DRAFT       // 編集中（取引・予算の変更可）
  SUBMITTED   // 提出済み（ロック: 取引・予算の更新・削除不可）
  APPROVED    // 承認済み（ロック: 同上）
}

model FiscalYear {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year            Int               // 年度（例: 2025 = 2025年4月〜2026年3月）
  startDate       DateTime          // 期首日（例: 2025-04-01）
  endDate         DateTime          // 期末日（例: 2026-03-31）
  status          FiscalYearStatus  @default(DRAFT)
  
  // 決算処理関連
  closedAt        DateTime?         // 決算確定日時
  carryOverAmount Decimal?          @db.Decimal(12, 2) // 次期繰越金
  
  createdById     String?
  createdBy       User?             @relation("FiscalYearCreator", fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // リレーション
  transactions    Transaction[]
  balanceRecords  BalanceRecord[]   // 残高確認記録
  budget          Budget?

  @@unique([organizationId, year])
  @@index([organizationId])
  @@index([status])
}

// ============================================
// カテゴリー（部門）管理
// 仕様書 3.1: 部門（カテゴリー）管理
// ============================================

model Category {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String        // カテゴリー名（例: 部会計、合宿会計、遠征費）
  order           Int           @default(0) // 表示順序（ドラッグ&ドロップ用）
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // リレーション
  accountTitles   AccountTitleCategory[]
  transactions    Transaction[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([order])
}

// ============================================
// 勘定科目マスター
// 仕様書 3.2: 勘定科目体系
// ============================================

enum AccountGroup {
  CASH_DEPOSIT    // 現金・預金（現金、普通預金等）
  ASSET           // 資産（未収入金、前払費用）
  LIABILITY       // 負債（預り金、未払金）
  INCOME          // 収入（部費、寄付金、助成金等）
  EXPENSE         // 支出（消耗品費、大会参加費等）
}

// 繰延処理用の固定科目識別子
enum DeferredAccountType {
  ACCOUNTS_RECEIVABLE   // 未収入金（資産）
  ADVANCE_PAYMENT       // 前払費用（資産）
  ACCOUNTS_PAYABLE      // 未払金（負債）
  ADVANCE_RECEIPT       // 預り金（負債）
}

model AccountTitle {
  id                  String              @id @default(cuid())
  organizationId      String?
  organization        Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                String?             // 科目コード（任意）
  name                String
  group               AccountGroup
  deferredType        DeferredAccountType? // 繰延処理用科目の場合のみ設定
  
  // 期首残高（初年度設定用）
  openingBalance      Decimal?            @db.Decimal(12, 2)
  
  // マスター管理
  isMaster            Boolean             @default(false)  // 大学側のマスター科目か
  isSystemRequired    Boolean             @default(false)  // システム必須科目か（削除不可）
  
  // 階層構造（オプション）
  parentId            String?
  parent              AccountTitle?       @relation("AccountTitleHierarchy", fields: [parentId], references: [id])
  children            AccountTitle[]      @relation("AccountTitleHierarchy")
  
  order               Int                 @default(0) // 表示順序
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // リレーション
  categories          AccountTitleCategory[]
  transactions        Transaction[]
  balanceRecords      BalanceRecord[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([group])
  @@index([isMaster])
  @@index([deferredType])
}

// 科目とカテゴリーの中間テーブル（多対多）
model AccountTitleCategory {
  id              String        @id @default(cuid())
  accountTitleId  String
  accountTitle    AccountTitle  @relation(fields: [accountTitleId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([accountTitleId, categoryId])
  @@index([accountTitleId])
  @@index([categoryId])
}

// ============================================
// 取引（仕訳）
// ============================================

enum TransactionStatus {
  NORMAL      // 通常
  DEFERRED    // 繰延（次年度へ繰り越し）
  SETTLED     // 精算済み（繰延の消し込み完了）
}

enum TransactionType {
  INCOME      // 収入
  EXPENSE     // 支出
  TRANSFER    // 振替（現金・預金間の移動）
  COLLECTION  // 集金
  DEFERRED    // 繰延（計上・消込）
}

enum ApprovalStatus {
  DRAFT              // 下書き
  PENDING            // 承認待ち（クラブ申請中）
  FACULTY_PENDING    // 顧問承認待ち
  UNIVERSITY_PENDING // 大学承認待ち（for School版）
  APPROVED           // 承認済み
  REJECTED           // 却下
  BLOCKED            // ブロック（アラート未解消のため承認不可）
}

model Transaction {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYearId    String
  fiscalYear      FiscalYear        @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        Category?         @relation(fields: [categoryId], references: [id])
  accountTitleId  String
  accountTitle    AccountTitle      @relation(fields: [accountTitleId], references: [id])
  userId          String?
  user            User?             @relation(fields: [userId], references: [id])
  
  // 取引情報
  type            TransactionType
  amount          Decimal           @db.Decimal(12, 2)
  date            DateTime          @db.Date
  counterparty    String?           // 入金先/出金元の科目名（振替用）
  description     String?           // メモ
  
  // 証憑（エビデンス）管理
  receiptUrl      String?           // 証憑画像URL
  receiptUploadedAt DateTime?       // 証憑アップロード日時
  
  // ============================================
  // 異常検知・アラート連携（仕様書セクション4）
  // ============================================
  isAlert         Boolean           @default(false)  // 異常検知フラグ
  alertType       AlertType?        // アラート種別
  alertResolvedAt DateTime?         // アラート解消日時
  
  // 取引ステータス
  status          TransactionStatus @default(NORMAL)
  
  /// 入力担当者名（単式運用・誰が登録したか）。未設定時は null
  recordedBy      String?
  
  // ============================================
  // 承認フロー連携（for School版）
  // isAlert=true の場合、approvalStatus は BLOCKED になる
  // ============================================
  approvalStatus  ApprovalStatus    @default(DRAFT)
  
  // 繰延・精算関連
  deferredFromId  String?           // 繰延元の取引ID（消込時に参照）
  deferredFrom    Transaction?      @relation("TransactionDeferred", fields: [deferredFromId], references: [id])
  deferredTo      Transaction[]     @relation("TransactionDeferred")
  deferredType    DeferredProcessType? // 繰延処理の種別（計上/消込）
  settledAt       DateTime?         // 精算日時
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // リレーション
  approvals       Approval[]
  alerts          Alert[]           // 関連するアラート履歴

  @@index([organizationId])
  @@index([fiscalYearId])
  @@index([categoryId])
  @@index([accountTitleId])
  @@index([userId])
  @@index([date])
  @@index([type])
  @@index([status])
  @@index([approvalStatus])
  @@index([isAlert])
  @@index([alertType])
}

// 繰延処理の種別
enum DeferredProcessType {
  RECORD      // 計上（来年度のお金として予約）
  SETTLEMENT  // 消込（前年度の予約を精算）
}

// ============================================
// 異常検知・アラート管理（仕様書セクション4）
// ============================================

enum AlertType {
  MISSING_RECEIPT       // 証憑（エビデンス）不足
  DUPLICATE_ENTRY       // 二重登録
  BALANCE_MISMATCH      // 残高不整合
  HIGH_AMOUNT           // 高額取引（閾値超過）
  INVALID_DATE          // 不正な日付（会計年度外）
  APPROVAL_TIMEOUT      // 承認タイムアウト
}

enum AlertStatus {
  OPEN        // 未解消
  RESOLVED    // 解消済み
  IGNORED     // 無視（正当な理由あり）
}

model Alert {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactionId   String?
  transaction     Transaction?    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  
  type            AlertType
  status          AlertStatus     @default(OPEN)
  message         String          // アラートメッセージ
  details         Json?           // 詳細情報（重複取引IDなど）
  
  // 解消情報
  resolvedById    String?
  resolvedBy      User?           @relation("AlertResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt      DateTime?
  resolvedComment String?         // 解消時のコメント
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizationId])
  @@index([transactionId])
  @@index([type])
  @@index([status])
}

// ============================================
// 承認フロー（for School版）
// ============================================

enum ApprovalLevel {
  CLUB       // クラブ申請
  FACULTY    // 顧問承認
  UNIVERSITY // 大学承認
}

model Approval {
  id            String          @id @default(cuid())
  transactionId String
  transaction   Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  level         ApprovalLevel
  status        ApprovalStatus
  comment       String?
  
  // アラート確認（承認者がアラートを確認したか）
  alertChecked  Boolean         @default(false)
  
  approvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([transactionId])
  @@index([userId])
  @@index([level])
  @@index([status])
}

// ============================================
// 残高確認記録（決算処理用）
// 仕様書セクション5: 決算処理ワークフロー
// ============================================

model BalanceRecord {
  id              String        @id @default(cuid())
  fiscalYearId    String
  fiscalYear      FiscalYear    @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  accountTitleId  String
  accountTitle    AccountTitle  @relation(fields: [accountTitleId], references: [id])
  
  // 残高情報
  systemBalance   Decimal       @db.Decimal(12, 2)  // システム計算残高
  actualBalance   Decimal?      @db.Decimal(12, 2)  // ユーザー入力の実残高
  isMatched       Boolean       @default(false)     // 残高一致確認済み
  
  // エビデンス
  evidenceUrl     String?       // 通帳残高画像/現金残高画像URL
  evidenceUploadedAt DateTime?
  
  // 確認情報
  confirmedAt     DateTime?
  confirmedById   String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([fiscalYearId, accountTitleId])
  @@index([fiscalYearId])
  @@index([accountTitleId])
  @@index([isMatched])
}

// ============================================
// 保護者・部員管理
// ============================================

model Parent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String?
  name           String?
  phone          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members Member[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
}

model Member {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  studentId       String?         // 学籍番号
  email           String?
  phone           String?
  grade           Int?            // 学年（1〜4）
  isActive        Boolean         @default(true)
  
  // 保護者閲覧用トークン（仕様書6.3）
  parentViewToken String?         @unique // 一意のトークン（URL用）
  parentEmail     String?         // 保護者メールアドレス
  parentPhone     String?         // 保護者電話番号（移行用。正は Parent とのリレーション）

  parentId        String?
  parent          Parent?         @relation(fields: [parentId], references: [id], onDelete: SetNull)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // リレーション
  collectionItems CollectionItem[]

  @@index([organizationId])
  @@index([parentId])
  @@index([studentId])
  @@index([grade])
  @@index([parentViewToken])
}

// ============================================
// 集金管理
// ============================================

enum CollectionStatus {
  SCHEDULED   // 予約済み（未請求）
  PENDING     // 請求中（未収）
  COLLECTED   // 収納済み
  OVERDUE     // 滞納
  CANCELLED   // キャンセル
}

model CollectionItem {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId        String
  member          Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  // 集金情報
  name            String            // 集金名（例: 4月部費）
  amount          Decimal           @db.Decimal(12, 2)
  dueDate         DateTime          @db.Date // 納付期限
  targetMonth     DateTime?         @db.Date // 対象月（月次集金用）
  
  status          CollectionStatus  @default(SCHEDULED)
  collectedAt     DateTime?         // 収納日時
  collectedAmount Decimal?          @db.Decimal(12, 2) // 実際の収納額
  description     String?

  paymentExternalId String?         @unique // 外部決済プロバイダ側の ID
  paymentProvider   String?         // 例: stripe, gmo 等（識別子）
  paymentStatus     String?           // PSP の最終状態スナップショット
  paymentUpdatedAt  DateTime?         // 決済状態を最後に反映した日時
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([organizationId])
  @@index([memberId])
  @@index([status])
  @@index([dueDate])
  @@index([targetMonth])
}

// ============================================
// システム通知・お知らせ
// ============================================

enum NotificationType {
  SYSTEM          // システム通知
  ALERT           // アラート通知
  APPROVAL        // 承認関連
  COLLECTION      // 集金関連
  FISCAL_YEAR     // 年度関連
}

model Notification {
  id              String            @id @default(cuid())
  organizationId  String
  type            NotificationType
  title           String
  message         String
  isRead          Boolean           @default(false)
  readAt          DateTime?
  
  // 関連エンティティ（オプション）
  relatedType     String?           // 関連エンティティの種別
  relatedId       String?           // 関連エンティティのID
  
  createdAt       DateTime          @default(now())

  @@index([organizationId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

// ============================================
// 予実管理（予算書）— カテゴリ×科目×年度の予算額
// ============================================

/// 会計年度に 1:1 で紐づく予算ブック。明細は BudgetLine。
model Budget {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYearId   String       @unique
  fiscalYear     FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  lines          BudgetLine[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model BudgetLine {
  id             String   @id @default(cuid())
  budgetId       String
  budget         Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId     String
  accountTitleId String
  amount         Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([budgetId, categoryId, accountTitleId])
  @@index([budgetId])
}
