# ============================================================
# 全環境で共通の設定
# ============================================================

# リソース名のプレフィックス
PROJECT="kurasapo"

# インフラ設計書 §2.2 のとおり、データは国内リージョンに固定する
AWS_REGION="ap-northeast-1"

# ============================================================
# 事故防止ガード（★ 両方の設定が必須。未設定だとスクリプトは起動しない）
#
# AWS CLI は --profile も AWS_PROFILE も指定しないと、必ず
# ~/.aws/credentials の [default] を使う。開発機に複数プロジェクトの
# プロファイルがある場合、指定漏れ＝別プロジェクトのアカウントを
# 操作する事故に直結する。
#
# そのため本スクリプト群は「プロファイル名」と「期待するアカウント ID」の
# 両方を必須にし、どちらか欠けていれば何もせず停止する。
# [default] へのフォールバックは起こらない。
# ============================================================

# 使用する AWS プロファイル名（~/.aws/credentials のセクション名）
# 確認: aws configure list-profiles
#
# ★ 未設定。クラサポ会計用の AWS アカウントが未決定のため。
#    決まり次第ここに書く。書くまでスクリプトは何も実行しない。
#
# 開発機の既存プロファイルは他プロジェクトのもの。本プロジェクトでは使わない:
#   Stay-Sync     (579617311268) … Stay-Sync ※旧 [default]。誤用防止のためリネーム済み
#   en-scheduler  (266913442918)
#   ehd-dev       (304838115932)
#   kpe           (497675597696)
#   kidsplus-work (924955165193)
#   kidsplus-link (459119163530)
#   mado-kit      (519741283869)
AWS_PROFILE_NAME=""

# 上記プロファイルが指すべき AWS アカウント ID（12 桁）
# 確認: AWS_PROFILE=<name> aws sts get-caller-identity --query Account --output text
# 実際のアカウントと一致しなければ即中断する
EXPECTED_ACCOUNT_ID=""

# --- ネットワーク（VPC は prod / staging で共有）--------------
VPC_CIDR="10.0.0.0/16"
AZ_A="ap-northeast-1a"
AZ_C="ap-northeast-1c"

# ALB の仕様上 2 AZ のサブネットが必須。
# ただし稼働リソース（ECS / RDS）は AZ_A に寄せる ＝ 実質シングル AZ 運用。
# サブネットの作成自体は無料（インフラ設計書 §3.2）。
PUBLIC_SUBNET_A_CIDR="10.0.0.0/24"
PUBLIC_SUBNET_C_CIDR="10.0.1.0/24"
PRIVATE_SUBNET_A_CIDR="10.0.20.0/24"
PRIVATE_SUBNET_C_CIDR="10.0.21.0/24"

# --- コンテナ ------------------------------------------------
CONTAINER_NAME="app"
CONTAINER_PORT="3000"

# ALB のアイドルタイムアウト（秒）と、コンテナ側 keep-alive（ミリ秒）。
# ★ KEEP_ALIVE_TIMEOUT_MS > ALB_IDLE_TIMEOUT_SEC × 1000 を必ず守ること。
#   逆転すると ALB が再利用しようとした接続を Node が先に閉じ、
#   散発的な 502 Bad Gateway が起きる（サーバー仕様書 §7.2）。
#   Next.js standalone は KEEP_ALIVE_TIMEOUT 環境変数を読む。
ALB_IDLE_TIMEOUT_SEC="60"
KEEP_ALIVE_TIMEOUT_MS="65000"

# Node のヒープ上限（MB）。タスクメモリ 1024MB のうち、
# OS・Prisma エンジン・その他に約 300MB を残す配分（サーバー仕様書 §3.1）。
NODE_MAX_OLD_SPACE_MB="640"

# --- PostgreSQL パラメータグループ ---------------------------
DB_PARAMETER_GROUP_FAMILY="postgres16"
# スロークエリとみなす閾値（ミリ秒）。これを超えるとログに出る
DB_LOG_MIN_DURATION_MS="1000"
# アイドルのままトランザクションを掴み続ける接続を切る（ミリ秒）
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS="60000"
# ソート・ハッシュ用の作業メモリ（KB）。接続数×同時実行数ぶん消費しうる
DB_WORK_MEM_KB="8192"

# --- データベース --------------------------------------------
DB_ENGINE="postgres"
DB_ENGINE_VERSION="16.4"
DB_NAME="kurasapo"
DB_MASTER_USERNAME="kurasapo_admin"
DB_PORT="5432"

# --- ドメイン（任意）-----------------------------------------
# 設定した場合: ALB に HTTPS:443 リスナーを作り、ホスト名で prod / staging を振り分ける。
# 空の場合  : HTTP:80(prod) / HTTP:8080(staging) で構築する。
#             ドメイン取得前でも動作確認できるようにするため。
DOMAIN_NAME=""
ACM_CERTIFICATE_ARN=""

# --- アラート通知先 ------------------------------------------
# SNS トピックにサブスクライブするメールアドレス（空なら購読を作らない）
ALERT_EMAIL=""
