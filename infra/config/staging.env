# ============================================================
# ステージング環境（staging）
# インフラ設計書 §6.2 の構成。月額 約 2,700 円
#
# 本番と VPC・ALB を共有し、リソースだけ環境ごとに分ける。
# ただし RDS インスタンスは本番と別にする（誤操作が本番会計データに届く経路を作らない）。
# ============================================================

# --- ECS -----------------------------------------------------
TASK_CPU="512"
TASK_MEMORY="1024"
ECS_DESIRED_COUNT="1"
ECS_AUTOSCALE_MIN="0"   # スケジュール停止で 0 まで落とす
ECS_AUTOSCALE_MAX="2"

# --- RDS -----------------------------------------------------
DB_INSTANCE_CLASS="db.t4g.micro"
DB_MULTI_AZ="false"
DB_ALLOCATED_STORAGE="20"
DB_MAX_ALLOCATED_STORAGE="50"
DB_BACKUP_RETENTION="1"
DB_DELETION_PROTECTION="false"
DB_BACKUP_WINDOW="17:00-18:00"
DB_MAINTENANCE_WINDOW="sat:18:00-sat:19:00"

# --- ALB リスナー ---------------------------------------------
# DOMAIN_NAME 未設定時は本番が 80、staging が 8080 を使う
HTTP_LISTENER_PORT="8080"

# --- ログ ----------------------------------------------------
LOG_RETENTION_DAYS="7"

# --- スケジュール停止（インフラ設計書 §3.9）-------------------
# 平日 08:00 起動 / 20:00 停止（JST）。cron は UTC で書く。
SCHEDULE_ENABLED="true"
SCHEDULE_START_CRON="cron(0 23 ? * SUN-THU *)"  # UTC 23:00 = JST 翌08:00（月〜金）
SCHEDULE_STOP_CRON="cron(0 11 ? * MON-FRI *)"   # UTC 11:00 = JST 20:00
