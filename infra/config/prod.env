# ============================================================
# 本番環境（prod）
# インフラ設計書 §6.1 の構成。月額 約 14,100 円（WAF / GuardDuty 有効時）
# ============================================================

# --- ECS -----------------------------------------------------
TASK_CPU="512"          # 0.5 vCPU
TASK_MEMORY="1024"      # 1 GB
ECS_DESIRED_COUNT="1"   # AZ 冗長は当面行わない。2 にすると +3,450 円/月（§6.7 第 1 順位）
ECS_AUTOSCALE_MIN="1"
ECS_AUTOSCALE_MAX="3"

# --- RDS -----------------------------------------------------
DB_INSTANCE_CLASS="db.t4g.micro"
DB_MULTI_AZ="false"          # AZ 冗長化は当面行わない（§6.7 第 4 順位）
DB_ALLOCATED_STORAGE="20"
DB_MAX_ALLOCATED_STORAGE="100"
DB_BACKUP_RETENTION="7"
DB_DELETION_PROTECTION="true"
DB_BACKUP_WINDOW="18:00-19:00"           # UTC ＝ JST 03:00-04:00
DB_MAINTENANCE_WINDOW="sun:19:00-sun:20:00"  # UTC ＝ JST 日曜 04:00-05:00

# --- ALB リスナー（DOMAIN_NAME 未設定時に使うポート）----------
HTTP_LISTENER_PORT="80"

# --- ログ ----------------------------------------------------
LOG_RETENTION_DAYS="14"
